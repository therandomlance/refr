// refr schema — see SPEC.md §4, §13.3

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model File {
    id        String    @id // sha256 hex
    size      BigInt
    mtime     DateTime // from best-known path; grouping/sorting key
    width     Int?
    height    Int?
    duration  Float? // seconds, video only
    mediaType String // "image" | "video"
    addedAt   DateTime  @default(now())
    paths     FilePath[]
    tags      FileTag[]
    embedding FileEmbedding?
    denials   SuggestionDenial[]
    candidates TagCandidate[]
    meta      FileMeta?

    @@index([mtime, id]) // keyset pagination for default sort
    @@index([mediaType])
}

model FilePath {
    id     Int      @id @default(autoincrement())
    path   String   @unique
    fileId String
    size   BigInt // stat at scan time — drift detection
    mtime  DateTime // stat at scan time — drift detection
    file   File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@index([fileId])
}

model Tag {
    id    Int        @id @default(autoincrement())
    name  String     @unique
    files FileTag[]
    vector TagVector?
    classifiers TagClassifier[]
    candidates TagCandidate[]
    sweep TagSweep?

    @@index([name])
}

model FileTag {
    fileId String
    tagId  Int
    file   File @relation(fields: [fileId], references: [id], onDelete: Cascade)
    tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([fileId, tagId])
    @@index([tagId, fileId])
}

model FileEmbedding {
    fileId    String   @id
    vector    Bytes // 768 x float32 LE, L2-normalized
    model     String
    updatedAt DateTime @updatedAt
    file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@index([model, updatedAt]) // covering index for the sidecar's cache stamp
}

model TagVector {
    tagId        Int    @id
    vector       Bytes // combined text+centroid, L2-normalized
    fileCount    Int
    linksVersion Int
    model        String
    tag          Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

/// Per-tag classifiers (ml.tagModel = "auto"). Keyed by rule version
/// (+ anchoring knobs) and model so new rules never overwrite old rows. Derived cache; TagVector is
/// independent of it. weights/bias null = too few positives (use TagVector).
model TagClassifier {
    tagId     Int
    variant   String // e.g. "anchored-v1|w=0.5"
    model     String
    weights   Bytes? // 768 x float32 LE
    bias      Float?
    positives Int
    negatives Int
    tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

    @@id([tagId, variant, model])
    @@index([variant, model])
}

model Meta {
    key   String @id
    value String // "linksVersion": int, bumped by every tag-link mutation
}

model SuggestionDenial {
    tagName String
    fileId  String
    file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@id([tagName, fileId])
    @@index([tagName])
}

/// Tagging inbox (src/server/services/sweep.ts): calibrated candidates per tag
/// from the background sweep. Derived cache — rebuilt by the next sweep.
/// confidence = fraction of the tag's own images scoring ≤ this file (0..1).
model TagCandidate {
    tagId           Int
    fileId          String
    confidence      Float
    score           Float
    mode            Int // nearest sub-style prototype of the tag
    rank            Int // diversified (MMR) review order within the tag
    rivalTag        String? // sibling tag this file looks more like (or already has)
    rivalConfidence Float?
    nearDenial      Boolean // close to an image rejected for this tag
    sweptAt         DateTime
    tag             Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
    file            File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@id([tagId, fileId])
    @@index([tagId, rank])
    @@index([fileId])
}

/// Per-tag sweep summary: positives, sub-style count, exemplar fileIds per mode.
model TagSweep {
    tagId     Int      @id
    positives Int
    modes     Int
    exemplars String // JSON string[][] (per mode)
    sweptAt   DateTime
    tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

/// Per-file user data + derived extras, 1:1 with File, created lazily (upsert).
/// A separate table rather than File columns: CREATE TABLE IF NOT EXISTS stays
/// idempotent with the boot fallback in instrumentation-node.ts; ALTER ADD COLUMN isn't.
model FileMeta {
    fileId      String    @id
    favorite    Boolean   @default(false)
    dhash       BigInt? // 64-bit difference hash of the thumbnail (duplicates.ts)
    duplicateOf String? // set = hidden near-duplicate of this keeper fileId
    source      String? // origin URL
    note        String? // markdown note
    takenAt     DateTime? // EXIF DateTimeOriginal
    camera      String? // EXIF Make + Model
    exifChecked Boolean   @default(false) // probed for EXIF (backfill runs once per file)
    file        File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

    @@index([favorite])
    @@index([duplicateOf])
}

/// "Not duplicates" decisions from the duplicate finder; a < b.
model DuplicateDismissal {
    a String
    b String

    @@id([a, b])
}
